<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <!-- Gazteen emantzipazioaren adierazlea (iovj-emancipacion.csv) -->
    <xs:complexType name="AdierazleaType">
        <xs:sequence>
            <xs:element name="Adierazlea_Izena" type="xs:string" />
            <xs:element name="Adierazlea_Urtea" type="xs:gYear" />
            <xs:element name="Adierazlea_Balioa" type="xs:double" />
            <xs:element name="Adierazlea_Kategoria" type="xs:string" minOccurs="0" />
            <xs:element name="Adierazlea_Kategoria_Balioa" type="xs:string" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>

    <xs:element name="Adierazlea" type="AdierazleaType" />

    <xs:element name="Adierazleak">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="Adierazlea" minOccurs="0" maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
